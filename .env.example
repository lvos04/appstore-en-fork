# appstore-en-fork — omgevingsvariabelen (ALLEEN voor ontwikkeling; de Custom App heeft géén verplichte variabelen).
# Nooit echte geheimen in dit bestand of in Git. Geheimen maakt de app zelf in $APPSTORE_DATA_DIR/secrets.

# Datamap (in de image: /appdata). Bevat postgres/, secrets/ (0700; vault.key, identity.ed25519 en de koppelstatus
# hub-link.json, elk 0600) en backups/.
APPSTORE_DATA_DIR=./.appdata
# Database. In de image: unix-socket "postgresql+psycopg://appstore@/appstore?host=/tmp/appstore-pg".
# Ontwikkeling met de gedeelde PostgreSQL: maak eerst een eigen database met het prefix appstore_.
APPSTORE_DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:5432/appstore_dev
APPSTORE_HOST=127.0.0.1
APPSTORE_PORT=30430
APPSTORE_LOG_LEVEL=info
# Map met ingebouwde manifesten (in de image: /usr/local/share/appstore/catalog)
APPSTORE_BUNDLED_CATALOG_DIR=./catalog/bundled
# Alleen ontwikkeling/tests: sta http:// en lokale git-bronnen (file://) toe. In productie altijd leeg/0.
APPSTORE_ALLOW_INSECURE_SOURCES=0
# Alembic-map (standaard apps/api/alembic in de broncode)
# APPSTORE_ALEMBIC_DIR=apps/api/alembic

# Koppelen met de Hub (platformcontract 1.3 §3.2). Bij installatie via de Hub zet die alle drie. Handmatig: maak in de
# Hub een enrollment-token (aanbevolen) of koppel met koppelcode + vingerafdruk op de statuspagina (alleen zolang de
# app nog nooit gekoppeld is). Nooit echte waarden in dit bestand.
# Adres van de Hub: http(s)://<host>[:<poort>], zonder pad; geen loopback/link-local/0.0.0.0; IPv4 alleen als a.b.c.d
# (geen afgekorte vormen zoals 127.1), IPv6 tussen []. Ongeldig → last_error hub_adres_ongeldig, de Hub wordt niet gebeld.
HUB_URL=
# EENMALIG token: enr_ + 43 tekens base64url; vervalt na 60 min of na eerste gebruik. De oude naam ENROLLMENT_TOKEN
# wordt in deze release nog gelezen (met een waarschuwing in de log) en vervalt daarna.
HUB_ENROLLMENT_TOKEN=
# Verwachte sleutelset-vingerafdruk van de Hub (XXXX-XXXX-XXXX-XXXX, niet geheim). Aanwezig ⇒ verplicht gecontroleerd.
HUB_KEY_FINGERPRINT=
# Alleen ontwikkeling/tests: sta een Hub op een loopback-adres toe (bv. de simulator op 127.0.0.1). In productie leeg/0.
APPSTORE_ALLOW_LOOPBACK_HUB=0
# Optioneel: eigen bereikbaar adres dat aan de Hub wordt doorgegeven als base_url (alleen informatief; alleen als het
# aan de adresregels voldoet, anders stuurt de app null).
APPSTORE_PUBLIC_URL=
# B08-002: elke zoveel seconden de app-inventaris van de Hub lezen (alleen lezen; 0 = uit, alleen op verzoek via
# POST /catalog/v1/existing-apps/import). Toegestaan: 0 of 300…86400. Standaard 900. Hoort niet in het formulier.
APPSTORE_IMPORT_INTERVAL_S=900

# Tests: beheerverbinding om testdatabases appstore_test_<pid> / appstore_e2e_<pid> aan te maken
APPSTORE_TEST_DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:5432/postgres
