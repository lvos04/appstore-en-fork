# appstore-en-fork — omgevingsvariabelen (ALLEEN voor ontwikkeling; de Custom App heeft géén verplichte variabelen).
# Nooit echte geheimen in dit bestand of in Git. Geheimen maakt de app zelf in $APPSTORE_DATA_DIR/secrets.

# Datamap (in de image: /appdata). Bevat postgres/, secrets/ (0600) en backups/.
APPSTORE_DATA_DIR=./.appdata
# Database. In de image: unix-socket "postgresql+psycopg://appstore@/appstore?host=/tmp/appstore-pg".
# Ontwikkeling met de gedeelde PostgreSQL: maak eerst een eigen database met het prefix appstore_.
APPSTORE_DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:5432/appstore_dev
APPSTORE_HOST=127.0.0.1
APPSTORE_PORT=30430
APPSTORE_LOG_LEVEL=info
# Map met ingebouwde manifesten (in de image: /usr/local/share/appstore/catalog)
APPSTORE_BUNDLED_CATALOG_DIR=./catalog/bundled
# Alleen ontwikkeling/tests: sta http:// en lokale git-bronnen (file://) toe. In productie altijd leeg/0.
APPSTORE_ALLOW_INSECURE_SOURCES=0
# Alembic-map (standaard apps/api/alembic in de broncode)
# APPSTORE_ALEMBIC_DIR=apps/api/alembic

# Koppelen met de Hub. Bij installatie via de Hub zet die HUB_URL + een EENMALIG token (vervalt na 60 min of
# na eerste gebruik). Handmatig geïnstalleerd: leeg laten en koppelen met een koppelcode op de statuspagina.
HUB_URL=
HUB_ENROLLMENT_TOKEN=
# Optioneel: eigen bereikbaar adres dat aan de Hub wordt doorgegeven (anders bepaalt de Hub dat zelf).
APPSTORE_PUBLIC_URL=

# Tests: beheerverbinding om testdatabases appstore_test_<pid> / appstore_e2e_<pid> aan te maken
APPSTORE_TEST_DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:5432/postgres
